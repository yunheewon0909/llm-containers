#!/command/with-contenv sh
# shellcheck shell=sh
exec 2>&1
export HOME=/opt/data
export XDG_CACHE_HOME=/opt/data/.cache
export XDG_CONFIG_HOME=/opt/data/.config

while ! s6-setuidgid hermes xdpyinfo -display "${DISPLAY:-:99}" >/dev/null 2>&1; do
    s6-sleep 1
done

exec s6-setuidgid hermes openbox --sm-disable
